{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vocab.invalid/schema/gloss-id.json",
  "title": "L2 Indonesian gloss layer (keyed by L1 entry id)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "senses"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/entryId" },
    "senses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sid", "gloss"],
        "properties": {
          "sid": { "$ref": "common.json#/$defs/senseId" },
          "gloss": {
            "description": "1-3 short Indonesian equivalents. gloss[0] is the primary meaning shown in drills.",
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^\\S(.*\\S)?$" }
          },
          "hint": {
            "description": "Optional disambiguation for production drills (meaning -> word).",
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^\\S(.*\\S)?$"
          }
        }
      }
    },
    "prov": { "$ref": "common.json#/$defs/prov" }
  }
}
