{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vocab.invalid/schema/sentences.json",
  "title": "L3 example / cloze sentence",
  "description": "ja uses 漢字《よみ》 ruby on EVERY kanji run and exactly one {{...}} marker around the target as it appears in the sentence (may be inflected). Syntax is enforced by tools/lib/ja.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entry", "sid", "ja", "tr", "origin"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/sentenceId" },
    "entry": { "$ref": "common.json#/$defs/entryId" },
    "sid": { "$ref": "common.json#/$defs/senseId" },
    "ja": { "type": "string", "minLength": 4, "maxLength": 240 },
    "tr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 300 },
        "en": { "type": "string", "minLength": 2, "maxLength": 300 }
      }
    },
    "origin": { "enum": ["ai", "human", "tatoeba"] },
    "src_id": { "type": "string", "maxLength": 40 },
    "prov": { "$ref": "common.json#/$defs/prov" }
  }
}
